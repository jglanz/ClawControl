{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "strict": false,
    "outDir": "dist-electron"
  },
  "include": ["vite.config.ts", "electron/**/*"]
}
